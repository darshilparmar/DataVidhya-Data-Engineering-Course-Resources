# Copy to .env in the project root and fill in your own values.
# Never commit the filled-in .env.

# Public connection coordinates
DATABRICKS_HOST=https://<your-workspace>.cloud.databricks.com
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/<your-warehouse-id>
DBT_CLOUD_API_BASE=https://<your-dbt-access-url>/api/v2
DBT_CLOUD_ACCOUNT_ID=<from your dbt Cloud URL>

# API keys: free signups at openweathermap.org, waqi.info, openaq.org
OPENWEATHER_KEY=
WAQI_TOKEN=
OPENAQ_KEY=

# Secrets: paste your own, never commit this file once filled
DATABRICKS_TOKEN=
DATABRICKS_JOB_ID=
DBT_CLOUD_API_TOKEN=
DBT_CLOUD_JOB_ID=
